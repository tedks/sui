module(name = "sui")

bazel_dep(name = "rules_rust", version = "0.74.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.70.0"],
)
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")

# Start with the self-contained Prometheus closure metric package. The native
# Cargo workspace and its pinned 1.70 toolchain remain the full graph.
crates = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
# The native crate's workspace-hack edge unifies these features for the
# selected closure. Keep that effective feature set while omitting the rest
# of the large workspace-hack graph.
crates.spec(package = "anyhow", version = "=1.0.71", features = ["backtrace"])
crates.spec(package = "bytes", version = "=1.4.0", features = ["serde"])
crates.spec(package = "lazy_static", version = "=1.4.0", features = ["spin_no_std"])
crates.spec(package = "prometheus", version = "=0.13.3")
crates.spec(package = "protobuf", version = "=2.28.0", features = ["with-bytes"])
crates.from_specs(
    name = "metric_crates",
    cargo_lockfile = "//:Cargo.lock",
    skip_cargo_lockfile_overwrite = True,
    supported_platform_triples = ["x86_64-unknown-linux-gnu"],
)
use_repo(crates, "metric_crates")
